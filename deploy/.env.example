# Generate credentials with ./generate-env.sh. Never commit .env.
POSTGRES_DB=griyo
POSTGRES_USER=griyo
POSTGRES_PASSWORD=replaceWithRandom32Chars
DATABASE_URL=postgres://griyo:replaceWithRandom32Chars@postgres:5432/griyo?sslmode=disable
SERVICE_TOKEN=replaceWithRandom32Chars
OWNER_PASSWORD=replaceWithRandom32Chars
SESSION_SECRET=replaceWithRandom32Chars
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
WORKSPACE_GRPC_ADDR=workspace:50051
FLEET_GRPC_ADDR=fleet:50052
TASK_GRPC_ADDR=task:50053
GRIYO_URL=http://gateway:8080
RUNNER_TOKEN=
AI_API_KEY=
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
WORKSPACE_ROOT=/workspaces
